# Required production settings. Never commit the real values.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-random-32-plus-character-secret
DJANGO_ALLOWED_HOSTS=your-public-host.example.com
FRONTEND_URL=https://your-public-host.example.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://HOST:6379/0
# Optional overrides; production defaults both to REDIS_URL.
CELERY_BROKER_URL=redis://HOST:6379/0
CELERY_RESULT_BACKEND=redis://HOST:6379/0
CELERY_TASK_ALWAYS_EAGER=False

DEFAULT_FROM_EMAIL=no-reply@your-domain.example
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# The recommended deployment serves React + API + WebSocket from one origin,
# so these can remain blank. Fill them only if you intentionally split origins.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
REFRESH_COOKIE_SAMESITE=Strict
# REFRESH_COOKIE_DOMAIN=.example.com

# Persistent upload location. On a container platform, mount durable storage here.
MEDIA_ROOT=/app/media
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO
# Start small on a new hostname. After HTTPS/subdomains are proven, raise this.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Optional error monitoring.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
