# Local development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker uses these; plain local development uses SQLite + in-memory Channels.
DATABASE_URL=postgres://sheyihub:sheyihub@localhost:5432/sheyihub
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

DEFAULT_FROM_EMAIL=no-reply@sheyihub.local
FRONTEND_URL=http://localhost:5173

# Leave SMTP blank in development; email is printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
