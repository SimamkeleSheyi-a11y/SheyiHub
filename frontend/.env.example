# Local dev normally needs none of these. Vite proxies /api and /ws to Django.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Public WebRTC configuration. STUN identifiers are safe to expose in a browser bundle.
VITE_STUN_URL=stun:stun.l.google.com:19302

# Optional demo TURN configuration. Anything prefixed VITE_ is public in the
# browser bundle, so do NOT place a private long-lived TURN secret here.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
